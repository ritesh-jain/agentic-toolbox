{
  "name": "agentic-toolbox",
  "version": "0.2.0",
  "description": "Cross-platform AI agent & skill sync engine for Claude Code and OpenCode",
  "type": "module",
  "bin": {
    "agentic-toolbox": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "AGENTS.md",
    "README.md",
    "agents/",
    "skills/"
  ],
  "scripts": {
    "build": "tsc && tsc-alias",
    "dev": "npm run build && node dist/index.js",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "echo \"No tests yet\" && exit 0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ritesh-jain/agentic-toolbox.git"
  },
  "bugs": {
    "url": "https://github.com/ritesh-jain/agentic-toolbox/issues"
  },
  "homepage": "https://github.com/ritesh-jain/agentic-toolbox#readme",
  "license": "MIT",
  "keywords": [
    "ai",
    "agents",
    "skills",
    "claude",
    "opencode",
    "sync"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "agentic-toolbox": "0.1.8",
    "tsc-alias": "^1.9.9",
    "typescript": "^7.0.2"
  }
}
